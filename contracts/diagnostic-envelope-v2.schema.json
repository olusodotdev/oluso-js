{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oluso.dev/contracts/diagnostic-envelope-v2.schema.json",
  "title": "Oluso diagnostic envelope v2",
  "type": "object",
  "required": ["schema_version", "title", "message", "environment", "severity", "sdk"],
  "properties": {
    "schema_version": { "const": 2 },
    "title": { "type": "string", "minLength": 1, "maxLength": 100 },
    "message": { "type": "string", "minLength": 1 },
    "stack_trace": { "type": "string" },
    "environment": { "enum": ["production", "staging", "development"] },
    "severity": { "enum": ["critical", "high", "medium", "low"] },
    "fingerprint": { "type": "string" },
    "exception": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "cause_chain": { "type": "array", "items": { "type": "object" }, "maxItems": 10 }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "properties": {
        "request": { "type": "object" },
        "response": { "type": "object" },
        "breadcrumbs": { "type": "array", "maxItems": 100 },
        "trace": { "type": "object" },
        "release": { "type": "object" }
      },
      "additionalProperties": true
    },
    "sdk": {
      "type": "object",
      "required": ["name", "version", "language"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
